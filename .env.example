# Environment Variables for BOQ Estimation System
# Copy this file to .env and fill in your values

# Anthropic API Key (required for drawing extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Flask Web Application (optional - only needed for web interface)
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_DEBUG=False
PORT=5000

# Gunicorn Configuration (Production)
GUNICORN_WORKERS=4
LOG_LEVEL=info

# Optional: Custom configuration
# REGION=Delhi
# DSR_YEAR=2024
