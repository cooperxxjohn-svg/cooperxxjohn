# Painting.ai Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# API Keys
# =============================================================================

# Anthropic API for Claude AI (required)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Stripe Payment Processing (Phase 6)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid Email Service (Phase 7)
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@painting.ai

# =============================================================================
# AWS S3 Configuration (Week 2)
# =============================================================================

# AWS Credentials
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# S3 Buckets
AWS_S3_BUCKET_UPLOADS=painting-ai-uploads-prod
AWS_S3_BUCKET_EXPORTS=painting-ai-exports-prod

# Signed URL Configuration
S3_SIGNED_URL_EXPIRY=86400  # 24 hours in seconds (default: 86400)

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/painting_ai

# Redis (for caching and background jobs)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Security & Authentication
# =============================================================================

# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# JWT Token Expiration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30      # 30 days

# API Key Salt (generate with: openssl rand -hex 16)
API_KEY_SALT=your-api-key-salt-here

# =============================================================================
# Application Configuration
# =============================================================================

# Environment
ENVIRONMENT=development  # development, staging, production

# Debug Mode
DEBUG=true

# API URL
API_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# File Upload Configuration
# =============================================================================

# Max file size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# Allowed file extensions
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg

# =============================================================================
# Email Configuration
# =============================================================================

# Email notifications
EMAIL_ENABLED=true

# Email templates
WELCOME_EMAIL_TEMPLATE_ID=d-...
RECEIPT_EMAIL_TEMPLATE_ID=d-...

# =============================================================================
# Rate Limiting
# =============================================================================

# API rate limits
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# Monitoring & Analytics
# =============================================================================

# Sentry Error Tracking (optional)
SENTRY_DSN=https://...@sentry.io/...

# Google Analytics (optional)
GA_TRACKING_ID=G-...

# =============================================================================
# Background Jobs (Celery)
# =============================================================================

# Celery Broker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Feature Flags
# =============================================================================

# Enable experimental features
ENABLE_AI_PROCESSING=true
ENABLE_ASSEMBLY_EXPANSION=true
ENABLE_PDF_EXPORT=true
ENABLE_WEBHOOK_NOTIFICATIONS=true

# =============================================================================
# Usage Limits (per plan)
# =============================================================================

# Starter Plan
STARTER_PROJECTS_LIMIT=25
STARTER_API_CALLS_LIMIT=1000

# Pro Plan
PRO_PROJECTS_LIMIT=999999
PRO_API_CALLS_LIMIT=999999
